# Banco Postgres (local: docker compose up -d | produção: Neon / Supabase)
DATABASE_URL="postgresql://gestor:gestor@localhost:5432/gestor"

# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Mínimo 32 caracteres. NUNCA compartilhe nem suba no GitHub.
AUTH_SECRET="troque-isto-por-um-segredo-grande-de-32-caracteres-ou-mais"

# Protege o endpoint do resumo diário (/api/cron/daily-brief)
CRON_SECRET="outro-segredo-aleatorio-diferente-do-auth"

# "false" fecha novos cadastros (só quem já tem conta entra)
ALLOW_SIGNUP="true"

# Opcional — token grátis em https://brapi.dev (cotações da B3)
BRAPI_TOKEN=""

# Opcional — se preenchido, o resumo diário é escrito pelo Claude
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-haiku-4-5"

# Opcional — ativos que entram no resumo diário do mercado
WATCH_STOCKS="PETR4,VALE3,ITUB4,BBAS3,WEGE3,BOVA11,IVVB11"
WATCH_CRYPTO="bitcoin,ethereum,solana"
